{
  "version": 1,
  "about": "Android policy of the Elymon sync (com.elythera.elymon.sync.AndroidPolicy). Phase 0 validated this content on a Galaxy S24 Ultra with 113 of 124 mods.",
  "excludeMods": [
    "distanthorizons",
    "iris",
    "irisscalefix",
    "euphoria_patcher",
    "cobblemon_vocalized",
    "crash_assistant",
    "controlify",
    "c2me",
    "connector",
    "swingthrough",
    "unilib"
  ],
  "excludeFilePrefixes": [
    "shaderpacks/",
    "config/defaultoptions/extra/saves/",
    "config/defaultoptions/extra/shaderpacks/",
    "config/craftpresence.json"
  ],
  "overlays": [
    {
      "path": "config/fml.toml",
      "ops": [
        { "op": "tomlSet", "set": { "earlyWindowControl": "false" } }
      ]
    },
    {
      "path": "config/defaultoptions/keybindings.txt",
      "ops": [
        { "op": "colonKeySet", "set": {
            "key_key.attack": "key.mouse.left:",
            "key_key.use": "key.mouse.right:",
            "key_key.forward": "key.keyboard.w:",
            "key_key.left": "key.keyboard.a:",
            "key_key.back": "key.keyboard.s:",
            "key_key.right": "key.keyboard.d:",
            "key_key.jump": "key.keyboard.space:",
            "key_key.sneak": "key.keyboard.left.shift:",
            "key_key.sprint": "key.keyboard.left.control:",
            "key_key.drop": "key.keyboard.q:",
            "key_key.inventory": "key.keyboard.e:",
            "key_key.chat": "key.keyboard.t:",
            "key_key.playerlist": "key.keyboard.tab:",
            "key_key.togglePerspective": "key.keyboard.f5:",
            "key_key.swapOffhand": "key.keyboard.f:",
            "key_key.hotbar.1": "key.keyboard.1:",
            "key_key.hotbar.2": "key.keyboard.2:",
            "key_key.hotbar.3": "key.keyboard.3:",
            "key_key.hotbar.4": "key.keyboard.4:",
            "key_key.hotbar.5": "key.keyboard.5:",
            "key_key.hotbar.6": "key.keyboard.6:",
            "key_key.hotbar.7": "key.keyboard.7:",
            "key_key.hotbar.8": "key.keyboard.8:",
            "key_key.hotbar.9": "key.keyboard.9:",
            "key_key.saveToolbarActivator": "key.keyboard.unknown:",
            "key_key.loadToolbarActivator": "key.keyboard.unknown:",
            "key_key.cobblemon.throwpartypokemon": "key.keyboard.r:",
            "key_key.cobblemon.summary": "key.keyboard.m:",
            "key_key.cobblemon.hideparty": "key.keyboard.o:",
            "key_key.cobblemon.upshiftparty": "key.keyboard.up:",
            "key_key.cobblemon.downshiftparty": "key.keyboard.down:",
            "key_key.cobblemon.ridingfreelook": "key.keyboard.left.alt:",
            "key_key.elymon.menu": "key.keyboard.j:",
            "key_key.elythera.zoom": "key.keyboard.c:",
            "key_key.cobblemon_smartphone.open": "key.keyboard.k:",
            "key_key.cobblemon_smartphone.scanner": "key.keyboard.x:",
            "key_key.petyourcobblemon.toggleinteractmode": "key.keyboard.g:",
            "key_key.push_to_talk": "key.mouse.5:",
            "key_key.voice_chat": "key.keyboard.v:",
            "key_key.mute_microphone": "key.keyboard.unknown:",
            "key_key.disable_voice_chat": "key.keyboard.unknown:",
            "key_key.hide_icons": "key.keyboard.unknown:",
            "key_key.voice_chat_group": "key.keyboard.unknown:",
            "key_gui.xaero_open_map": "key.keyboard.n:",
            "key_gui.xaero_waypoints_key": "key.keyboard.u:",
            "key_gui.xaero_new_waypoint": "key.keyboard.f6:",
            "key_gui.xaero_enlarge_map": "key.keyboard.z:",
            "key_key.ftbchunks.map": "key.keyboard.grave.accent:",
            "key_key.pokebike.headlight": "key.keyboard.f7:",
            "key_accessories.key.open_accessories_screen": "key.keyboard.h:",
            "key_key.sophisticatedbackpacks.open_backpack": "key.keyboard.b:",
            "key_key.sophisticatedbackpacks.inventory_interaction": "key.keyboard.unknown:",
            "key_key.sophisticatedbackpacks.toggle_upgrade_1": "key.keyboard.unknown:",
            "key_key.sophisticatedbackpacks.toggle_upgrade_2": "key.keyboard.unknown:",
            "key_justzoom.keybinds.keybind.zoom": "key.keyboard.unknown:"
        } }
      ]
    }
  ],
  "seedOptions": {
    "lang": "fr_fr",
    "renderDistance": "8",
    "simulationDistance": "6",
    "maxFps": "60",
    "graphicsMode": "0",
    "particles": "1",
    "mipmapLevels": "2",
    "biomeBlendRadius": "1",
    "entityShadows": "false",
    "renderClouds": "\"false\"",
    "toggleCrouch": "true",
    "fullscreen": "false",
    "enableVsync": "false"
  }
}
