<?xml version="1.0" encoding="utf-8"?>
<!-- "À propos et licences" (com.elythera.elymon.ui.ElymonAboutFragment). The third-party
     components and the licence texts of assets/licenses are added in code. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <net.kdt.pojavlaunch.prefs.BackButtonPreference/>

    <Preference
        android:key="elymon_about_app"
        android:persistent="false"
        android:selectable="false"
        android:title="@string/app_short_name"
        android:icon="@mipmap/ic_launcher" />

    <Preference
        android:key="elymon_about_source"
        android:persistent="false"
        android:title="@string/elymon_about_source_title"
        android:summary="@string/elymon_about_source_url" />

    <Preference
        android:key="elymon_about_license"
        android:persistent="false"
        android:title="@string/elymon_about_license_title"
        android:summary="@string/elymon_about_license_summary" />

    <PreferenceCategory android:title="@string/elymon_about_credits_category">
        <Preference
            android:key="elymon_about_amethyst"
            android:persistent="false"
            android:title="@string/elymon_about_amethyst_title"
            android:summary="@string/elymon_about_amethyst_summary" />
        <Preference
            android:key="elymon_about_pojav"
            android:persistent="false"
            android:title="@string/elymon_about_pojav_title"
            android:summary="@string/elymon_about_pojav_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="elymon_about_components"
        android:title="@string/elymon_about_components_category" />

    <PreferenceCategory
        android:key="elymon_about_files"
        android:title="@string/elymon_about_files_category" />

    <PreferenceCategory android:title="@string/elymon_about_notice_category">
        <Preference
            android:key="elymon_about_notice"
            android:persistent="false"
            android:selectable="false"
            android:summary="@string/elymon_about_notice" />
    </PreferenceCategory>
</PreferenceScreen>
