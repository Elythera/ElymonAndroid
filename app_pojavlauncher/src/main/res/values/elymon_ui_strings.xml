    <string name="elymon_about_amethyst_title" translatable="false">Amethyst-Android</string>
    <string name="elymon_about_amethyst_summary">Elymon est un fork d\'Amethyst-Android, développé par AngelAuraMC et ses contributeurs, sous licence LGPL 3.0. Merci à eux.</string>
    <string name="elymon_about_amethyst_url" translatable="false">https://github.com/AngelAuraMC/Amethyst-Android</string>
