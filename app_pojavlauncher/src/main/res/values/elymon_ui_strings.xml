<?xml version="1.0" encoding="utf-8"?>
<!-- Elymon ui package: home screen, settings, "À propos", memory warning. French, in the
     default folder on purpose (DESIGN.md): every locale, French included, uses these texts. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- Home -->
    <string name="elymon_home_play">Jouer</string>
    <string name="elymon_home_logo_description">Elymon</string>
    <!-- Status line under Play. %1$s: pack version ("2.4.6"), %2$s: Minecraft version, %3$s: app version -->
    <string name="elymon_home_status_full">Elymon %1$s · Minecraft %2$s · application %3$s</string>
    <!-- %1$s: pack version, %2$s: app version -->
    <string name="elymon_home_status_pack">Elymon %1$s · application %2$s</string>
    <!-- Before the first sync. %1$s: app version -->
    <string name="elymon_home_status_app">Application %1$s</string>

    <!-- Settings: Elymon section -->
    <string name="elymon_settings_category">Elymon</string>
    <string name="elymon_settings_renderer_title">Moteur de rendu</string>
    <string name="elymon_settings_renderer_mobileglues">MobileGlues (recommandé)</string>
    <string name="elymon_settings_renderer_zink">Kopper Zink (Vulkan)</string>
    <!-- %1$s: the renderer chosen -->
    <string name="elymon_settings_renderer_summary">%1$s. Essaie l\'autre moteur seulement si le jeu s\'affiche mal ou plante au démarrage.</string>
    <string name="elymon_settings_renderer_only">%1$s : le seul moteur compatible avec ce téléphone.</string>
    <string name="elymon_settings_renderer_error">Impossible d\'enregistrer le moteur de rendu. Réessaie.</string>
    <string name="elymon_settings_memory_title">Mémoire allouée</string>
    <!-- %1$d: recommended heap in MB for this phone, %2$d: largest heap without a warning -->
    <string name="elymon_settings_memory_summary">Recommandé pour ce téléphone : %1$d Mo. Au-delà de %2$d Mo, Android risque de fermer le jeu en pleine partie.</string>
    <string name="elymon_settings_memory_unit">" Mo"</string>
    <string name="elymon_settings_mic_title">Micro pour le chat vocal</string>
    <string name="elymon_settings_mic_granted">Autorisé : tu peux parler aux autres joueurs avec Simple Voice Chat.</string>
    <string name="elymon_settings_mic_ask">Non autorisé : touche ici pour autoriser le micro et parler avec Simple Voice Chat.</string>
    <string name="elymon_settings_mic_denied">Refusé : touche ici pour ouvrir les réglages d\'Android, puis autorise le micro dans Autorisations.</string>
    <string name="elymon_settings_mic_already">Le micro est déjà autorisé.</string>
    <string name="elymon_settings_controls_title">Contrôles tactiles</string>
    <string name="elymon_settings_controls_summary">Déplace, redimensionne ou ajoute les boutons affichés en jeu.</string>
    <string name="elymon_settings_folder_title">Ouvrir le dossier du jeu</string>
    <string name="elymon_settings_folder_summary">Captures d\'écran, packs de ressources et mondes, dans le gestionnaire de fichiers.</string>
    <string name="elymon_settings_folder_missing">Le dossier du jeu n\'existe pas encore : appuie une première fois sur Jouer.</string>
    <string name="elymon_settings_folder_no_app">Aucune application de ce téléphone ne sait ouvrir ce dossier.</string>
    <string name="elymon_settings_logs_title">Envoyer les journaux</string>
    <string name="elymon_settings_logs_summary">Pour aider l\'équipe Elythera à comprendre un problème. Les informations de connexion en sont retirées.</string>
    <string name="elymon_settings_update_title">Vérifier les mises à jour</string>
    <!-- %1$s: installed app version -->
    <string name="elymon_settings_update_summary">Version installée : %1$s</string>
    <string name="elymon_settings_about_title">À propos et licences</string>
    <string name="elymon_settings_about_summary">Version, code source, licences et remerciements</string>
    <string name="elymon_settings_other_category">Réglages détaillés</string>

    <!-- Memory warning before the game starts -->
    <string name="elymon_memory_warning_title">Beaucoup de mémoire allouée</string>
    <!-- %1$d: heap in MB, %2$d: total RAM of the phone in MB, %3$d: largest heap without a warning -->
    <string name="elymon_memory_warning_message">Le jeu va réserver %1$d Mo de mémoire, sur les %2$d Mo de ce téléphone. Android risque de le fermer en pleine partie. Si cela arrive, règle la mémoire allouée à %3$d Mo ou moins dans les paramètres d\'Elymon.</string>
    <string name="elymon_memory_warning_play">Jouer quand même</string>
    <string name="elymon_memory_warning_never">Ne plus afficher</string>

    <!-- Microphone, asked once before the first Play -->
    <string name="elymon_mic_prompt_title">Chat vocal</string>
    <string name="elymon_mic_prompt_message">Elymon inclut Simple Voice Chat pour parler aux autres joueurs. Autorise le micro si tu veux parler. Tu pourras changer d\'avis dans les paramètres.</string>
    <string name="elymon_mic_prompt_allow">Autoriser le micro</string>
    <string name="elymon_mic_prompt_later">Pas maintenant</string>

